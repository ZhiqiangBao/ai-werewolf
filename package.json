{
  "name": "ai-werewolf",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "type": "module",
  "scripts": {
    "i18n:check": "tsx scripts/check-locales.ts",
    "observability:baseline": "tsx packages/session/scripts/observability-synthetic.ts",
    "observability:report": "tsx packages/session/scripts/observability-report.ts",
    "observability:accept": "tsx packages/session/scripts/observability-accept.ts",
    "dev": "tsx apps/server/src/main.ts --dev",
    "build": "pnpm --filter @werewolf/web exec vite build",
    "start": "node scripts/service.mjs start",
    "restart": "node scripts/service.mjs restart",
    "stop": "node scripts/service.mjs stop",
    "status": "node scripts/service.mjs status",
    "asr:start": "node scripts/asr/service.mjs start",
    "asr:stop": "node scripts/asr/service.mjs stop",
    "asr:restart": "node scripts/asr/service.mjs restart",
    "asr:status": "node scripts/asr/service.mjs status",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "simulate": "tsx packages/engine/scripts/simulate.ts",
    "models:migrate": "tsx scripts/migrate-models.ts",
    "models:maintain": "tsx scripts/model-maintenance.ts",
    "video:export": "tsx packages/session/scripts/export-video.ts",
    "video:tts": "tsx scripts/video/synthesize.ts",
    "video:audit-audio": "tsx scripts/video/audit-audio.ts",
    "video:review-audio": "tsx scripts/video/review-audio.ts",
    "video:import-alignment": "tsx scripts/video/import-audio-alignment.ts",
    "video:repair-audio": "tsx scripts/video/repair-audio.ts",
    "video:publish-copy": "tsx scripts/video/publish-copy.ts",
    "video:timeline": "tsx scripts/video/timeline.ts",
    "video:render": "tsx scripts/video/render.ts",
    "video:verify": "tsx scripts/video/verify.ts",
    "video:make": "tsx scripts/video/workflow.ts",
    "video:compress": "tsx scripts/video/compress.ts"
  },
  "devDependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
